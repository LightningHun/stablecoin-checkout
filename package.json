{
  "name": "stablecoin-checkout",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/serve.ts",
    "preview": "tsx scripts/serve.ts --preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "build": "vite build",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:mutation": "tsx tests/audit/run.ts",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test:unit && npm run test:component && npm run test:contract && npm run test:e2e && npm run test:visual"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "vue": "3.5.43",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "26.1.0",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
